# ---- LLM providers (set at least one; all have free tiers, no credit card) ----
# Tried in LLM_PROVIDERS order. If every one fails, Contexta still answers in
# "extractive" mode (best passages with citations), so the demo never dies.
GROQ_API_KEY=            # https://console.groq.com/keys  (recommended primary)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=      # https://openrouter.ai/keys

# Optional model overrides (model IDs change over time - check provider docs)
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Any OpenAI-compatible endpoint (Cerebras, Together, a hosted Ollama, ...)
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_API_KEY=
# LLM_MODEL=

# LLM_PROVIDERS=groq,gemini,openrouter,custom   # OpenRouter only: LLM_PROVIDERS=openrouter
# LLM_TIMEOUT=25              # seconds per provider call
# LLM_MAX_ATTEMPTS=2          # 1-3 generation attempts per question in the LangGraph workflow
# REQUIRE_LLM=false           # true = refuse to start without a configured provider

# ---- Tuning (defaults are fine) ----
# RERANK_MODEL=none            # default Xenova/ms-marco-MiniLM-L-6-v2 (reranking on); "none" turns it off
# QUERY_REWRITE=off           # Phase 3: single | multi | decompose | selective (+1 LLM call)
# REWRITE_PROVIDERS=          # rewrite with another chain, e.g. "custom" for a local Ollama
# CLAIM_CHECK=off             # "llm": check cited claims against their sources (+1 LLM call)
# RATE_LIMIT_PER_MIN=20
# TRUST_PROXY_HEADERS=true    # use the right-most X-Forwarded-For hop (set false if not behind a proxy)
# ARXIV_ENABLED=true
# ARXIV_BUDGET_S=9
# MIN_SCORE=                  # unset: 0.225 on fastembed, 0.075 on hash embeddings
# ALLOWED_ORIGINS=*
# MAX_PDF_MB=4

# ---- Embeddings ----
# EMBED_BACKEND=fastembed     # "hash" = no model download, for tests only (poor retrieval quality)
# FASTEMBED_CACHE_PATH=       # where the ONNX model is cached

# ---- Logging ----
# LOG_LEVEL=INFO
# LOG_FORMAT=text             # "json" for production log aggregation
# METRICS_ENABLED=true        # GET /metrics (Prometheus); no user content

# ---- Database (Phase 1a) ----
# Local dev (docker compose up -d db): postgresql://postgres:postgres@localhost:55432/contexta
# Production: the Supabase project's connection string (Settings -> Database -> Connection string)
DATABASE_URL=

# ---- Object storage (Phase 1b) ----
# local = filesystem under STORAGE_DIR (dev/tests only - not persistent on Render/Vercel)
# supabase = Supabase Storage bucket via its REST API (set SUPABASE_URL + SUPABASE_SERVICE_KEY)
STORAGE_BACKEND=local
STORAGE_DIR=.storage
STORAGE_BUCKET=documents
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---- Auth + rate limiting (Phase 1d) ----
# Supabase Dashboard -> Settings -> API -> JWT Secret (used to verify user tokens locally,
# no network call needed). MUST be set before deploying real workspace traffic.
SUPABASE_JWT_SECRET=
MAX_UPLOAD_MB=20
# Upstash Redis connection string (rediss://...). Falls back to in-memory limiting if unset -
# fine for one instance/local dev, NOT fine for a multi-instance production deployment.
REDIS_URL=                    # shared answer cache + rate limits across instances
WORKSPACE_RATE_LIMIT_PER_MIN=60
